# Copy to .env for local use. Never commit a real .env file.
# CI provides these through the platform secret store.

# Read-only GitHub token used by the catalog engine to raise API rate limits.
# Scope: public repository read. Never grant write scope to indexing jobs.
GITHUB_TOKEN=

# API / web runtime
LEGO_API_PORT=8787
LEGO_CORS_ORIGIN=http://localhost:5173
LEGO_LOG_LEVEL=info
LEGO_REPO_ROOT=

# RAG service (optional). Without a key the service uses the deterministic
# extractive answerer and never calls an external model.
LEGO_RAG_STORE=.data/rag-store.sqlite3
LEGO_RAG_EMBEDDER=hashing
OPENROUTER_API_KEY=
LEGO_RAG_MODEL=

# Observability (optional locally)
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=manus-lego
